@article{coppersmith2006ordering,
  title = {Ordering by Weighted Number of Wins Gives a Good Ranking for Weighted Tournaments},
  author = {Coppersmith, Don and Fleischer, Lisa and Rudra, Atri},
  journal = {ACM Transactions on Algorithms},
  volume = {6},
  number = {3},
  pages = {55:1--55:13},
  year = {2010},
  note = {Originally presented at SODA 2006, pp.\ 776--782. Proves that ranking vertices of a weighted tournament by weighted out-degree (equivalently, weighted number of wins) is a 5-approximation to the exact Kemeny-optimal ranking, provided weights satisfy the probability constraint $w_{uv}+w_{vu}=1$; also shows the bound is tight (a family of tournaments exists for which no tie-break improves on $5-\epsilon$). Directly applies to this work's $\text{quality}_i$ ranking (Section~\ref{sec:formal-model}), since $W[j,i]:=1-W[i,j]$ by construction.}
}

